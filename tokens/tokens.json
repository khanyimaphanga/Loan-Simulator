{
  "$description": "Capitec Loan Simulator design tokens (W3C DTCG format). Tier 1 = primitives, tier 2 = semantic (themeable), tier 3 = component. Edit here, then run `npm run tokens`.",
  "primitive": {
    "color": {
      "blue": {
        "50":  { "$type": "color", "$value": "#E6F6FD" },
        "100": { "$type": "color", "$value": "#C2E9FA" },
        "200": { "$type": "color", "$value": "#8AD4F4" },
        "400": { "$type": "color", "$value": "#33B4EA" },
        "500": { "$type": "color", "$value": "#009DE0", "$description": "Capitec blue (brand)" },
        "600": { "$type": "color", "$value": "#0082BC" },
        "700": { "$type": "color", "$value": "#006A9C", "$description": "Action blue: 5.6:1 on white, AA for body text" },
        "800": { "$type": "color", "$value": "#00507A" },
        "900": { "$type": "color", "$value": "#0A2240", "$description": "Capitec navy" }
      },
      "red": {
        "50":  { "$type": "color", "$value": "#FDECEA" },
        "300": { "$type": "color", "$value": "#E8483A" },
        "500": { "$type": "color", "$value": "#DA291C", "$description": "Capitec red (brand)" },
        "700": { "$type": "color", "$value": "#A81E14" }
      },
      "green": {
        "50":  { "$type": "color", "$value": "#E7F6EE" },
        "300": { "$type": "color", "$value": "#4CC38A" },
        "600": { "$type": "color", "$value": "#0E8A4F" },
        "700": { "$type": "color", "$value": "#0A6E3F" }
      },
      "amber": {
        "50":  { "$type": "color", "$value": "#FFF5E0" },
        "300": { "$type": "color", "$value": "#F2B544" },
        "500": { "$type": "color", "$value": "#C98B00" },
        "600": { "$type": "color", "$value": "#B98000" },
        "700": { "$type": "color", "$value": "#8A5A00" }
      },
      "slate": {
        "400": { "$type": "color", "$value": "#7286CC" },
        "500": { "$type": "color", "$value": "#5A6FB8" }
      },
      "neutral": {
        "0":   { "$type": "color", "$value": "#FFFFFF" },
        "25":  { "$type": "color", "$value": "#F7F9FB" },
        "50":  { "$type": "color", "$value": "#EEF2F6" },
        "100": { "$type": "color", "$value": "#E1E7EE" },
        "200": { "$type": "color", "$value": "#C9D2DC" },
        "400": { "$type": "color", "$value": "#8795A6" },
        "500": { "$type": "color", "$value": "#5F6E80" },
        "600": { "$type": "color", "$value": "#465566" },
        "800": { "$type": "color", "$value": "#1E2A38" },
        "850": { "$type": "color", "$value": "#16202B" },
        "900": { "$type": "color", "$value": "#0E1620" },
        "950": { "$type": "color", "$value": "#080D13" }
      }
    },
    "space": {
      "0":  { "$type": "dimension", "$value": "0" },
      "1":  { "$type": "dimension", "$value": "0.25rem" },
      "2":  { "$type": "dimension", "$value": "0.5rem" },
      "3":  { "$type": "dimension", "$value": "0.75rem" },
      "4":  { "$type": "dimension", "$value": "1rem" },
      "5":  { "$type": "dimension", "$value": "1.25rem" },
      "6":  { "$type": "dimension", "$value": "1.5rem" },
      "8":  { "$type": "dimension", "$value": "2rem" },
      "10": { "$type": "dimension", "$value": "2.5rem" },
      "12": { "$type": "dimension", "$value": "3rem" },
      "16": { "$type": "dimension", "$value": "4rem" }
    },
    "radius": {
      "sm":   { "$type": "dimension", "$value": "6px" },
      "md":   { "$type": "dimension", "$value": "10px" },
      "lg":   { "$type": "dimension", "$value": "16px" },
      "xl":   { "$type": "dimension", "$value": "24px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "font": {
      "family": {
        "sans": { "$type": "fontFamily", "$value": "'Inter Variable', Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
        "mono": { "$type": "fontFamily", "$value": "ui-monospace, 'SF Mono', Menlo, monospace" }
      },
      "size": {
        "xs":   { "$type": "dimension", "$value": "0.75rem" },
        "sm":   { "$type": "dimension", "$value": "0.875rem" },
        "md":   { "$type": "dimension", "$value": "1rem" },
        "lg":   { "$type": "dimension", "$value": "1.125rem" },
        "xl":   { "$type": "dimension", "$value": "1.375rem" },
        "2xl":  { "$type": "dimension", "$value": "1.75rem" },
        "3xl":  { "$type": "dimension", "$value": "clamp(1.875rem, 1.4rem + 2vw, 2.75rem)" },
        "hero": { "$type": "dimension", "$value": "clamp(2.25rem, 1.6rem + 3vw, 3.5rem)" }
      },
      "weight": {
        "regular":  { "$type": "fontWeight", "$value": 400 },
        "medium":   { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold":     { "$type": "fontWeight", "$value": 700 }
      },
      "lineHeight": {
        "tight": { "$type": "number", "$value": 1.15 },
        "snug":  { "$type": "number", "$value": 1.35 },
        "body":  { "$type": "number", "$value": 1.55 }
      }
    },
    "motion": {
      "duration": {
        "fast": { "$type": "duration", "$value": "120ms" },
        "base": { "$type": "duration", "$value": "220ms" },
        "slow": { "$type": "duration", "$value": "600ms" }
      },
      "easing": {
        "standard":   { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
        "emphasized": { "$type": "cubicBezier", "$value": "cubic-bezier(0.3, 0, 0, 1.2)" }
      }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "bg":              { "$value": "{primitive.color.neutral.25}" },
        "surface":         { "$value": "{primitive.color.neutral.0}" },
        "surface-sunken":  { "$value": "{primitive.color.neutral.50}" },
        "surface-brand":   { "$value": "{primitive.color.blue.900}" },
        "border":          { "$value": "{primitive.color.neutral.100}" },
        "border-strong":   { "$value": "{primitive.color.neutral.200}" },
        "text":            { "$value": "{primitive.color.blue.900}" },
        "text-muted":      { "$value": "{primitive.color.neutral.500}" },
        "text-on-brand":   { "$value": "{primitive.color.neutral.0}" },
        "brand":           { "$value": "{primitive.color.blue.500}" },
        "brand-soft":      { "$value": "{primitive.color.blue.50}" },
        "accent":          { "$value": "{primitive.color.red.500}" },
        "action":          { "$value": "{primitive.color.blue.700}" },
        "action-hover":    { "$value": "{primitive.color.blue.800}" },
        "action-text":     { "$value": "{primitive.color.neutral.0}" },
        "focus-ring":      { "$value": "{primitive.color.blue.400}" },
        "success":         { "$value": "{primitive.color.green.600}" },
        "success-soft":    { "$value": "{primitive.color.green.50}" },
        "success-text":    { "$value": "{primitive.color.green.700}" },
        "warning":         { "$value": "{primitive.color.amber.500}" },
        "warning-soft":    { "$value": "{primitive.color.amber.50}" },
        "warning-text":    { "$value": "{primitive.color.amber.700}" },
        "danger":          { "$value": "{primitive.color.red.500}" },
        "danger-soft":     { "$value": "{primitive.color.red.50}" },
        "danger-text":     { "$value": "{primitive.color.red.700}" },
        "chart-principal": { "$value": "{primitive.color.blue.500}" },
        "chart-interest":  { "$value": "{primitive.color.red.500}" },
        "chart-living":    { "$value": "{primitive.color.slate.500}" },
        "chart-debt":      { "$value": "{primitive.color.amber.500}" },
        "chart-loan":      { "$value": "{primitive.color.blue.500}" },
        "chart-track":     { "$value": "{primitive.color.neutral.50}" }
      },
      "shadow": {
        "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(10, 34, 64, 0.06), 0 1px 3px rgba(10, 34, 64, 0.08)" },
        "md": { "$type": "shadow", "$value": "0 4px 12px rgba(10, 34, 64, 0.08), 0 2px 4px rgba(10, 34, 64, 0.04)" },
        "lg": { "$type": "shadow", "$value": "0 16px 40px rgba(10, 34, 64, 0.12)" }
      }
    },
    "dark": {
      "color": {
        "bg":              { "$value": "{primitive.color.neutral.950}" },
        "surface":         { "$value": "{primitive.color.neutral.900}" },
        "surface-sunken":  { "$value": "{primitive.color.neutral.850}" },
        "surface-brand":   { "$value": "{primitive.color.neutral.850}" },
        "border":          { "$value": "{primitive.color.neutral.800}" },
        "border-strong":   { "$value": "{primitive.color.neutral.600}" },
        "text":            { "$value": "{primitive.color.neutral.50}" },
        "text-muted":      { "$value": "{primitive.color.neutral.400}" },
        "text-on-brand":   { "$value": "{primitive.color.neutral.0}" },
        "brand":           { "$value": "{primitive.color.blue.400}" },
        "brand-soft":      { "$value": "#0B2A3D" },
        "accent":          { "$value": "{primitive.color.red.300}" },
        "action":          { "$value": "{primitive.color.blue.400}" },
        "action-hover":    { "$value": "{primitive.color.blue.200}" },
        "action-text":     { "$value": "{primitive.color.blue.900}" },
        "focus-ring":      { "$value": "{primitive.color.blue.200}" },
        "success":         { "$value": "{primitive.color.green.300}" },
        "success-soft":    { "$value": "#0D2A1D" },
        "success-text":    { "$value": "{primitive.color.green.300}" },
        "warning":         { "$value": "{primitive.color.amber.300}" },
        "warning-soft":    { "$value": "#2E2410" },
        "warning-text":    { "$value": "{primitive.color.amber.300}" },
        "danger":          { "$value": "{primitive.color.red.300}" },
        "danger-soft":     { "$value": "#341614" },
        "danger-text":     { "$value": "{primitive.color.red.300}" },
        "chart-principal": { "$value": "{primitive.color.blue.500}" },
        "chart-interest":  { "$value": "{primitive.color.red.300}" },
        "chart-living":    { "$value": "{primitive.color.slate.400}" },
        "chart-debt":      { "$value": "{primitive.color.amber.600}" },
        "chart-loan":      { "$value": "{primitive.color.blue.500}" },
        "chart-track":     { "$value": "{primitive.color.neutral.800}" }
      },
      "shadow": {
        "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(0, 0, 0, 0.4)" },
        "md": { "$type": "shadow", "$value": "0 4px 12px rgba(0, 0, 0, 0.45)" },
        "lg": { "$type": "shadow", "$value": "0 16px 40px rgba(0, 0, 0, 0.55)" }
      }
    }
  },
  "component": {
    "button": {
      "height":  { "$type": "dimension", "$value": "3rem" },
      "radius":  { "$type": "dimension", "$value": "{primitive.radius.pill}" }
    },
    "input": {
      "height":  { "$type": "dimension", "$value": "3.25rem" },
      "radius":  { "$type": "dimension", "$value": "{primitive.radius.md}" }
    },
    "card": {
      "radius":  { "$type": "dimension", "$value": "{primitive.radius.lg}" },
      "padding": { "$type": "dimension", "$value": "clamp(1.25rem, 0.9rem + 1.5vw, 2rem)" }
    },
    "target": {
      "min":     { "$type": "dimension", "$value": "44px", "$description": "WCAG 2.5.5 minimum touch target" }
    }
  }
}
